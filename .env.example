# Copy this file to .env.local and fill in the values. .env.local is never committed.

# Gemini prediction markets (sandbox). Reading market data needs no key; trading does.
# https://exchange.sandbox.gemini.com -> Account -> Settings -> API
GEMINI_API_KEY=
GEMINI_API_SECRET=

# Context.dev: checks that an event and its organizer are real.
# https://www.context.dev -> sign up -> API keys
CONTEXT_DEV_API_KEY=

# XRPL testnet. No account needed: a funded test wallet comes from the faucet.
# https://xrpl.org/resources/dev-tools/xrp-faucets
XRPL_ISSUER_SEED=

# ElevenLabs: parked, not used yet. Kept here in case voice gets a real job later.
# Coupon through the hackathon Discord, then https://elevenlabs.io -> API keys
ELEVENLABS_API_KEY=
